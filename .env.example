# Configurações da aplicação
APP_ENV=development
APP_DEBUG=true
APP_NAME=Assessor Jurídico
APP_VERSION=1.0.0

# Banco de dados
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/juridico
POSTGRES_TEST_URL=postgresql://postgres:postgres@localhost:5432/juridico_test

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TEST_URL=redis://localhost:6379/1

# MinIO/S3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=juridico-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_SECURE=false

# Autenticação
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# IA/ML
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4-1106-preview
EMBEDDINGS_MODEL=text-embedding-ada-002

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@juridico.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Monitoramento
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true